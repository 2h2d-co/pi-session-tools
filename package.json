{
  "name": "@2h2d/pi-session-tools",
  "version": "0.0.3",
  "description": "Checkpoint inspection and context handoffs for Pi coding agents",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/2h2d-co/pi-session-tools#readme",
  "bugs": {
    "url": "https://github.com/2h2d-co/pi-session-tools/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Kaan Ozdokmeci",
    "email": "kaan@2h2d.co",
    "url": "https://www.2h2d.co"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2h2d-co/pi-session-tools.git"
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "check": "hk check --all --check",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:live": "PI_SESSION_TOOLS_LIVE_TEST=1 node --test test/packaged-cli.live.test.ts",
    "typecheck": "tsc --noEmit",
    "pack:dry": "npm pack --dry-run --ignore-scripts --allow-directory=all",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@2h2d/oxlint-config": "0.1.1",
    "@2h2d/ts-config": "0.0.1",
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@types/node": "22.20.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.0",
    "@earendil-works/pi-coding-agent": ">=0.87.0",
    "typebox": "^1.3.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  }
}
